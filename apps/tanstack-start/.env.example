# Optional: store images in S3 (or Cloudflare R2, MinIO, …) instead of public/.
# Copy to .env.local and fill in. Without MDX_MEDIA_S3_BUCKET, images stay in public/.

# MDX_MEDIA_S3_BUCKET=my-docs-images
# Public URL the bucket is served from (CDN / R2 custom domain). Written into your MDX.
# MDX_MEDIA_CDN_URL=https://images.example.com
# MDX_MEDIA_S3_REGION=us-east-1                      # "auto" by default when an endpoint is set
# MDX_MEDIA_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # R2 / MinIO / Spaces
# MDX_MEDIA_S3_ACCESS_KEY_ID=
# MDX_MEDIA_S3_SECRET_ACCESS_KEY=                    # omit both to use your AWS profile / SSO
# MDX_MEDIA_S3_PREFIX=images                          # key prefix
# MDX_MEDIA_S3_FORCE_PATH_STYLE=true                  # MinIO
