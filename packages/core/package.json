{
  "name": "@mdx-media-manager/core",
  "version": "0.0.0",
  "private": true,
  "description": "Internal: server side of mdx-media-manager (MDX editing, image processing, API). Bundled into mdx-media-manager, not published.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./node": "./dist/node.js",
    "./mdx": "./dist/mdx/index.js",
    "./slug": "./dist/slug.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch --clean false",
    "lint": "oxlint .",
    "test": "vitest run",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "magic-string": "^1.4.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.5",
    "unified": "^11.0.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.1",
    "aws-sdk-client-mock": "^4.1.0",
    "s3rver": "^3.7.1",
    "tsconfig": "workspace:*",
    "tsdown": "0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.1141.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    }
  }
