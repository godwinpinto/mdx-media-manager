{
  "name": "mdx-media-manager",
  "version": "0.0.0",
  "description": "Add, replace and delete images in MDX docs straight from the rendered page, during development",
  "keywords": [
    "dev-tools",
    "fumadocs",
    "images",
    "mdx",
    "next",
    "tanstack-start",
    "vite"
  ],
  "license": "MIT",
  "bin": {
    "mdx-media-manager": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./next": "./dist/next.js",
    "./vite": "./dist/vite.js",
    "./loader": "./dist/loader.js",
    "./client": "./dist/client.js",
    "./server": "./dist/server.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch --clean false",
    "lint": "oxlint .",
    "test": "vitest run",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@mdx-media-manager/core": "workspace:*",
    "@mdx-media-manager/ui": "workspace:*",
    "acorn": "^8.18.0",
    "magic-string": "^1.4.2",
    "oxc-parser": "^0.151.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "next": "16.3.6",
    "react": "^19.3.0",
    "tsconfig": "workspace:*",
    "tsdown": "0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "next": ">=15.3.0",
    "react": "^19.0.0",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
