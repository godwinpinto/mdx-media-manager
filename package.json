{
  "name": "root",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:format": "oxfmt --check",
    "format": "oxfmt",
    "test": "vitest",
    "types:check": "turbo run types:check --continue",
    "changeset": "changeset",
    "release": "turbo run build --filter=./packages/* && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "rimraf": "^6.1.3",
    "turbo": "2.11.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">= 24.14.0"
  },
  "packageManager": "pnpm@11.15.1"
}
